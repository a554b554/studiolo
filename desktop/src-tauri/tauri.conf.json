{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studiolo",
  "version": "0.2.4",
  "identifier": "net.studiolo.desktop",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Studiolo desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1N0Y1QUM4MzlDMzcwMTgKUldRWWNNTTV5RnAvbFV4U2xGa21RUU5XbHE1Z0V3cjQyMER1Z1RkanJJS04za0ZkV2E2MWpZNFQK",
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
